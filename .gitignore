# Local environments
.venv/
.r_libs_*/
.rlib/
.agents/
.codex/
AGENTS.md
RUN_STATUS.md
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Logs and scheduler output
logs/
*.log
slurm-*.out

# Large local data and model artifacts
nba_data/*
!nba_data/.gitkeep
data/*
!data/.gitkeep
!data/nba_raw/
data/nba_raw/*
!data/nba_raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/wp/
data/wp/*
!data/wp/.gitkeep
!data/analysis/
data/analysis/*
!data/analysis/.gitkeep
models/*
!models/.gitkeep

# Generated analysis outputs are excluded by default.
results/*
!results/.gitkeep
# Keep lightweight, human-readable result tables and summaries for review and
# manuscript reproduction; large parquet/model artifacts remain excluded.
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.txt
results/**/*.parquet
results/**/*.joblib
results/**/*.rds
results/**/*.gz
results/**/*.md
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.pdf
!results/README.md

# Temporary and local scratch files
.joblib/
tmp/
temp/
*.tmp
*.bak

# Retained manuscript figures
!figures/
!figures/*.png
